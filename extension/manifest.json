{
  "manifest_version": 3,
  "name": "AOC Claim Spot Watcher",
  "version": "1.2.5",
  "description": "Watch multiple AOC events using your existing Chrome login and click CLAIM PASSENGER SPOT or CLAIM SPOT once per event.",
  "permissions": ["storage", "notifications"],
  "host_permissions": ["https://arizonaoutdoorsclub.com/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "AOC Claim Spot Watcher" },
  "content_scripts": [{
    "matches": ["https://arizonaoutdoorsclub.com/*"],
    "js": ["matcher.js", "poller.js", "content.js"],
    "run_at": "document_start"
  }]
}
